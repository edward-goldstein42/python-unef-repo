        "https://gillinlaw.com/"
    ),
    "Rosche": LegalHelp(
        "Rosche Immigration Law",
        "Immigration legal services and consultations",
        "https://www.roscheimmigrationlaw.com/"
    )
}

#religious communal help

ReligiousHelp = namedtuple("ReligiousHelp", ["institution", "address", "website"])

religious_help = {
    "EGM": ReligiousHelp(
        "Everett Gospel Mission",
        "3711 Smith Ave, Everett WA",
        "https://egmission.org/"
    ),
    "Trinity": ReligiousHelp(
        "Trinity Lutheran Church",
        "2324 Lombard Ave, Everett WA",
        "http://www.trinitylutheraneverett.com/"
    ),
    "Bilal": ReligiousHelp(
        "Bilal Ibn Rabah Islamic Center",
        "607 SE Everett Mall Way, Everett WA",
