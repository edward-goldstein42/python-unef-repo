'''this is one of our data structures'''
from collections import namedtuple

# _data structures for information_


''' the next 5 sections are primarily just dictionaries of their set topics'''
#advocacy groups

AdvocacyGroup = namedtuple("AdvocacyGroup", ["name", "description", "website"])

advocacy_groups = {
    "NWIRP": AdvocacyGroup(
        "Northwest Immigrant Rights Project",
        "Provides legal assistance and advocacy for immigrants.",
        "https://www.nwirp.org"
    ),
    "WAISN": AdvocacyGroup(
        "Washington Immigrant Solidarity Network",
        "Advocacy network supporting immigrant communities.",
        "https://waisn.org"
    ),
    "ORIA": AdvocacyGroup(
        "Washington State Office of Refugee and Immigrant Assistance",
        "State office assisting refugees and immigrants.",
        "https://www.dshs.wa.gov/oria"
    )
}

#food programs
FoodProgram = namedtuple("FoodProgram", ["program", "agency", "eligibility", "website"])

food_help = {
    "SNAP": FoodProgram(
        "Supplemental Nutrition Assistance Program",
        "US Department of Agriculture",
        "US citizens or qualified immigrants meeting income/work rules",
        "https://www.dshs.wa.gov/"
    ),
    "FAP": FoodProgram(
        "Food Assistance Program",
        "WA Department of Social and Health Services",
        "Legal immigrants not eligible for SNAP",
        "https://www.dshs.wa.gov/"
    ),
    "HungerFreeWA": FoodProgram(
        "Hunger Free Washington",
        "Non-Profit Organization",
        "Community food programs available to many residents",
        "https://www.hungerfreewa.org/"
    )
}

#legal assistance
