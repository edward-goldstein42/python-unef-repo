def help_menu(immigration_eligibility):
    choice = 1
#    status_menu(immigration_eligibility)
    while choice >0:
        choice = int(input(
            "Choose what you want to see--\n\n"
            "Type 1 <-- For legal assistance in your surrounding area\n"
            "Type 2 <-- For faith based organizations\n"
            "Type 3 <-- For advocacy groups\n"
            "Type 4 <-- For food assistance\n"
            "Type 0 <-- Exit\n"
        ))

        if choice == 1:
            legal_info()
        elif choice == 2:
            faithbased_info()
        elif choice == 3:
            advocacy_info()
        elif choice ==4:
            food_assistance(immigration_eligibility)
        elif choice == 0:
            print("Goodbye")
            break
        else:
            print("~ only options: 0-4 ~")

